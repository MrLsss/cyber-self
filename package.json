{
  "name": "cyberself",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Per-directory personal knowledge base for DSH: import documents, retrieve evidence, answer with citations.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "cheerio": "^1.1.2",
    "domhandler": "^5.0.3",
    "mammoth": "^1.11.0",
    "unpdf": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.4",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "18.3.7",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "react": "^18.3.1"
  }
}
